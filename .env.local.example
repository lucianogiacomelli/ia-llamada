# ========================================================
# VARIABLES DE ENTORNO PARA EL AGENTE DE VOZ
# ========================================================

# Proveedor de TTS: "elevenlabs" o "edge_tts"
TTS_PROVIDER=elevenlabs

# API Key de ElevenLabs
ELEVENLABS_API_KEY=tu_api_key_aqui

# ID de la voz de ElevenLabs (ej. 4wDRKlxcHNOFO5kBvE81)
ELEVENLABS_VOICE_ID=4wDRKlxcHNOFO5kBvE81

# Modelo de ElevenLabs (eleven_v3, eleven_multilingual_v2, eleven_flash_v2_5)
ELEVENLABS_MODEL_ID=eleven_v3

# Modelo LLM de Ollama
OLLAMA_MODEL=qwen2.5:7b
